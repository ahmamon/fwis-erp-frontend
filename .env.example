# Copy this file to .env and adjust if needed.
# This is your real, live backend — the one already deployed and tested.
VITE_API_URL="https://academic.alsafwafuture.com"

# ------------------------------------------------------------------
# Azure AD / Microsoft 365 sign-in (uncomment & fill to enable).
# The app keeps working in dev-mode account-picker mode while these
# are blank — uncommenting flips it to real Microsoft login.
# ------------------------------------------------------------------
# VITE_AZURE_CLIENT_ID="00000000-0000-0000-0000-000000000000"
# VITE_AZURE_TENANT_ID="00000000-0000-0000-0000-000000000000"
# VITE_AZURE_SCOPE="api://<client-id>/access_as_user"   # optional — defaults to that
# VITE_AZURE_REDIRECT_URI=""                # optional — defaults to window.location.origin
